# Firebase / Google Cloud
# Em Firebase App Hosting, o Admin SDK pode usar as credenciais automáticas do ambiente.
# Use FIREBASE_SERVICE_ACCOUNT somente em desenvolvimento local quando necessário.
FIREBASE_SERVICE_ACCOUNT=

# Gemini API Key
GEMINI_API_KEY=

# Twilio (se este módulo continuar em uso)
TWILIO_WHATSAPP=+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# MultiCorban / BancoDataHub - SEGREDO DO BACKEND FIREBASE
# Nunca use NEXT_PUBLIC_.
MULTICORBAN_API_TOKEN=

# C6 Consignado - API oficial documentada
# O código já usa este domínio por padrão; mantenha somente para override controlado.
C6_API_BASE_URL=https://marketplace-proposal-service-api-p.c6bank.info
C6_API_TIMEOUT_MS=25000

# Simulação de REFIN INSS C6
# Prazo é fixado no backend em 108x conforme regra operacional.
C6_REFIN_FORMALIZATION_SUBTYPE=DIGITAL_WEB
C6_INSS_PUBLIC_AGENCY=000001
# Opcional: quando vazio, o backend tenta extrair do username C6 no formato *_000001.
C6_PROMOTER_CODE=
C6_REFIN_ACCEPT=application/vnd.c6bank_simulation_v1+json

# SEGREDO DO BACKEND FIREBASE para criptografar credenciais C6 individuais por UID.
# Use uma string aleatória forte de 32+ caracteres e mantenha a mesma chave.
C6_CREDENTIALS_ENCRYPTION_KEY=

# GUTTO / N8N
# NÃO coloque usuário/senha padrão do Gutto neste projeto Firebase.
# Essa credencial deve ficar no cofre Credentials do n8n (EasyPanel) e ser
# enviada ao /api/n8n somente durante a requisição via HTTPS.
