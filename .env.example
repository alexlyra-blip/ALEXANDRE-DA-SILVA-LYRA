# Firebase Secrets
# Add the full JSON string from your Firebase Service Account file (.json)
FIREBASE_SERVICE_ACCOUNT=

# Gemini API Key (Automatically set by platform, but can be overridden)
GEMINI_API_KEY=

# Twilio Configuration
# TWILIO_WHATSAPP should be the Sandbox number: +14155238886
TWILIO_WHATSAPP=+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
