rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // PHASE 3: Primitive Definitions
    // ---------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexlyra@gmail.com' ||
        request.auth.token.email == 'alexandrelyra@msn.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // ENTITY VALIDATION HELPERS
    // ---------------------------------------------------------

    function isValidSimulation(data) {
      return data.userId is string && 
             (data.userId == request.auth.uid || isAdmin()) &&
             (data.keys().hasAll(['userId']));
    }

    function isValidProposal(data) {
      return data.userId is string && 
             (data.userId == request.auth.uid || isAdmin());
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['admin', 'promotora', 'supervisor', 'corretor', 'vendedor'] &&
             data.status in ['active', 'pending', 'inactive'];
    }

    // ---------------------------------------------------------
    // DEFAULT DENY
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // COLLECTIONS
    // ---------------------------------------------------------

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming()) && userId == request.auth.uid;
      // Protected update: cannot change role/uid/status unless admin
      allow update: if isSignedIn() && (
        (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl', 'avatarUrl', 'phone'])) ||
        isAdmin()
      );
    }

    match /simulations/{simulationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSimulation(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && isValidSimulation(incoming()) && incoming().userId == existing().userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidProposal(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && isValidProposal(incoming()) && incoming().userId == existing().userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /bankRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /generalRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /general_rules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}
