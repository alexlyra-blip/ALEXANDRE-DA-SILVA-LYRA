rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexandrelyra@msn.com' || 
        request.auth.token.email == 'alexlyra@gmail.com' ||
        request.auth.token.email == 'alexandrelyra@gmail.com' ||
        request.auth.uid == 'AoFpOZClDnM3n5bTj3Ul32qvLIw2' ||
        request.auth.uid == '9L0530rP40Sj4fx2xtnXs63Bkqz2'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Bank Rules
    match /bankRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // General Rules
    match /generalRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Proposals
    match /proposals/{proposalId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.corretorId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }

    // Simulations
    match /simulations/{simulationId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // WhatsApp Sessions
    match /whatsappSessions/{document=**} {
      allow read, write: if true;
    }

    // WhatsApp Logs
    match /whatsappLogs/{document=**} {
      allow read, write: if true;
    }
    
    // Banks
    match /banks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
