{
  "entities": {
    "PromoterSettings": {
      "title": "PromoterSettings",
      "description": "Branding settings for the promoter",
      "type": "object",
      "properties": {
        "loginImageUrl": { "type": "string" },
        "primaryColor": { "type": "string" },
        "promoterName": { "type": "string" }
      },
      "required": ["loginImageUrl", "primaryColor"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing role and basic info",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "promotora", "supervisor", "corretor", "vendedor"] },
        "status": { "type": "string", "enum": ["active", "pending", "inactive"] },
        "createdAt": { "type": "timestamp" },
        "createdBy": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "photoUrl": { "type": "string" },
        "allowedBanks": { "type": "array", "items": { "type": "string" } },
        "maxUsers": { "type": "number" },
        "permissions": { "type": "object" },
        "promotoraId": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "status", "createdAt"]
    },
    "BankRule": {
      "title": "BankRule",
      "description": "Rules for a specific bank",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "minAge": { "type": "number" },
        "maxAge": { "type": "number" },
        "nonAcceptedBanks": { "type": "array", "items": { "type": "string" } },
        "acceptsIlliterate": { "type": "boolean" },
        "acceptsLOAS": { "type": "boolean" },
        "invalidezAgeYears": { "type": "number" },
        "acceptsOver60Invalidez": { "type": "boolean" },
        "minBenefitTimeYears": { "type": "number" },
        "minBenefitTimeMonths": { "type": "number" },
        "tabelas": { "type": "array" },
        "minInstallmentValue": { "type": "number" },
        "minBalance": { "type": "number" },
        "portabilityRate": { "type": "number" },
        "refinRate": { "type": "number" },
        "minTroco": { "type": "number" },
        "sumBalanceAndTroco": { "type": "boolean" },
        "logoUrl": { "type": "string" },
        "priority": { "type": "number", "description": "Preference order for simulation results (lower is better, e.g., 1 is top priority)" },
        "subConvenio": { "type": "string" }
      },
      "required": ["id", "name", "minAge", "maxAge", "acceptsIlliterate", "acceptsLOAS", "invalidezAgeYears", "acceptsOver60Invalidez", "minBenefitTimeYears", "minBenefitTimeMonths", "tabelas"]
    },
    "GeneralRule": {
      "title": "GeneralRule",
      "description": "General rules for portability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "banco": { "type": "string" },
        "parcelasAceitas": { "type": "number" }
      },
      "required": ["id", "banco", "parcelasAceitas"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Proposal record for tracking client applications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "promotoraId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientCpf": { "type": "string" },
        "proposalNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDENTE", "ANDAMENTO", "PAGO", "REPROVADO"] },
        "cipSentDate": { "type": "timestamp", "description": "Date when CIP was sent" },
        "expectedReturnDate": { "type": "timestamp", "description": "Calculated date for balance return (5 business days after cipSentDate)" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" },
        "simulationId": { "type": "string", "description": "Reference to the simulation that generated this proposal" },
        "bank": { "type": "string" },
        "value": { "type": "number" },
        "installments": { "type": "number" }
      },
      "required": ["userId", "clientName", "clientCpf", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profiles"
    },
    "/bankRules/{ruleId}": {
      "schema": { "$ref": "BankRule" },
      "description": "Bank rules"
    },
    "/generalRules/{ruleId}": {
      "schema": { "$ref": "GeneralRule" },
      "description": "General rules"
    },
    "/proposals/{proposalId}": {
      "schema": { "$ref": "Proposal" },
      "description": "Proposal records"
    },
    "/simulations/{simulationId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "userName": { "type": "string" },
          "userAvatar": { "type": "string" },
          "userRole": { "type": "string" },
          "createdBy": { "type": "string" },
          "promotoraId": { "type": "string" },
          "recommendedBanks": { "type": "array", "items": { "type": "string" } },
          "topOffer": { "type": "string" },
          "topOfferTabela": { "type": "string" },
          "topOfferContrato": { "type": "number" },
          "topOfferTroco": { "type": "number" },
          "topOfferTaxa": { "type": "number" },
          "topOfferPrazo": { "type": "number" },
          "convenio": { "type": "string" },
          "subConvenio": { "type": "string" },
          "bank": { "type": "string" },
          "rate": { "type": "number" },
          "value": { "type": "number" },
          "installments": { "type": "number" },
          "clientName": { "type": "string" },
          "clientCpf": { "type": "string" },
          "createdAt": { "type": "timestamp" }
        },
        "required": ["userId", "createdAt"]
      },
      "description": "Simulation records"
    },
    "/settings/promoter": {
      "schema": { "$ref": "PromoterSettings" },
      "description": "Promoter branding settings"
    }
  }
}
